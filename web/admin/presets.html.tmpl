{{define "presets-section"}}
<section id="section-presets">
	<h2>Presets</h2>
	<p class="hint">Save and restore your OSCWebMixer configuration (mixer layout, auxes).</p>
	<form hx-post="/admin/presets/save" hx-target="#section-presets" hx-swap="outerHTML" class="inline-form">
		<input type="text" name="name" placeholder="New preset name" required />
		<button type="submit">Save</button>
	</form>
	<button
		type="button"
		class="danger"
		hx-post="/admin/presets/reset"
		hx-target="#section-presets"
		hx-swap="outerHTML"
		hx-confirm="Reset EVERYTHING — all sources, sections, and aux settings — to defaults? Saved presets, external devices, and network settings are not affected. This cannot be undone."
	>Reset to defaults</button>

	<div class="cards">
	{{range .}}
		<div class="preset-card{{if .Active}} active{{end}}">
			<span class="label">{{.Name}}</span>
			<span class="preset-meta">{{prettyDate .LastChanged}}</span>
			<div class="preset-actions">
				<button hx-post="/admin/presets/{{.UUID}}/load" hx-target="#section-presets" hx-swap="outerHTML">Load</button>
				{{if .Active}}
				<button hx-post="/admin/presets/{{.UUID}}/update" hx-target="#section-presets" hx-swap="outerHTML">Update</button>
				{{end}}
				<button class="danger" hx-post="/admin/presets/{{.UUID}}/delete" hx-target="#section-presets" hx-swap="outerHTML" hx-confirm="Delete preset {{.Name}}? This cannot be undone.">Delete</button>
			</div>
		</div>
	{{else}}
		<p class="hint">No presets are currently saved.</p>
	{{end}}
	</div>
</section>
{{end}}
