{{define "layout"}}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>OSCWebMixer Admin</title>
<link rel="stylesheet" href="/admin/admin.css" />
<script src="/admin/htmx.min.js"></script>
<script src="/admin/sortable.min.js"></script>
</head>
<body>
<header class="topbar">
	<h1>OSCWebMixer Admin</h1>
	<div id="desk-status" hx-get="/admin/network/status" hx-trigger="load, every 5s" hx-swap="innerHTML">
		{{template "status-dot" .Network.DeskStatus}}
	</div>
</header>
<div id="flash">{{if .Message}}<p class="flash">{{.Message}}</p>{{end}}</div>

<nav class="tabs">
	<a href="#network" class="selected">Network</a>
	<a href="#external-devices">External devices</a>
	<a href="#sources">Sources</a>
	<a href="#auxes">Auxes</a>
	<a href="#presets">Presets</a>
	<a href="#settings">Settings</a>
</nav>

<div class="tab-panel show" id="tab-network">{{template "network-section" .Network}}</div>
<div class="tab-panel" id="tab-external-devices">{{template "external-devices-section" .Global}}</div>
<div class="tab-panel" id="tab-sources">{{template "sources-section" .SourcesData}}</div>
<div class="tab-panel" id="tab-auxes">{{template "auxes-section" .AuxesData}}</div>
<div class="tab-panel" id="tab-presets">{{template "presets-section" .Presets}}</div>
<div class="tab-panel" id="tab-settings">{{template "settings-section" .Global}}</div>

<script src="/admin/admin.js"></script>
</body>
</html>
{{end}}
