{{define "aux-send-on-button"}}<button type="button" id="aux-send-on-btn" hx-post="/admin/auxes/send-on" hx-target="this" hx-swap="outerHTML" title="Turn on the aux send for every enabled aux's visible sources on the desk">Set assigned sends to ON</button>{{end}}

{{define "aux-send-on-result"}}<button type="button" id="aux-send-on-btn" class="success" hx-get="/admin/auxes/send-on/reset" hx-trigger="load delay:5s" hx-target="this" hx-swap="outerHTML">Successfully set {{.}} aux send(s) to ON.</button>{{end}}

{{define "auxes-section"}}
<section id="section-auxes"{{if .OOB}} hx-swap-oob="true"{{end}}>
	<h2>Auxes</h2>
	<p class="hint">Auxes are the desk's mix buses - each one can become a personal mix a user can pick in the mixer app.</p>
	<div class="toolbar">
		<div class="toolbar-group">
			<button type="button" id="auxes-toggle-all">Show/Hide all</button>
			{{template "aux-send-on-button"}}
		</div>
	</div>
	<form id="auxes-form" hx-post="/admin/auxes" hx-target="#section-auxes" hx-swap="outerHTML">
		<div class="cards">
			{{range .Auxes}}
			{{$aux := .}}
			<div class="aux-card{{if .Stereo}} stereo{{end}}">
				<span class="badge">Aux {{.Channel}}</span>
				<span class="label">{{.Label}}</span>
				<span class="aux-controls">
					<span class="control-group">
						<span class="layout-label">Layout</span>
						<select name="layout[{{.Channel}}]" class="layout-select" title="Mixer layout">
							{{range $.Layouts}}
							<option value="{{.ID}}" {{if eq .ID $aux.LayoutID}}selected{{end}}>{{.Name}}</option>
							{{end}}
						</select>
					</span>
					<span class="control-group">
						<input type="color" name="colour[{{.Channel}}]" value="{{.Colour}}" />
						<span class="icon-picker">
							<button type="button" class="icon-picker-btn" popovertarget="icon-popup-{{.Channel}}" title="Icon">
								<img class="icon-preview" src="{{if .Icon}}/admin/icons/{{.Icon}}{{end}}" alt="" />
							</button>
							<input type="hidden" class="icon-value" name="icon[{{.Channel}}]" value="{{.Icon}}" />
							<div id="icon-popup-{{.Channel}}" popover class="icon-popup">
								<button type="button" class="icon-option{{if not .Icon}} selected{{end}}" data-icon="">No icon</button>
								{{range $.Icons}}
								<button type="button" class="icon-option{{if eq . $aux.Icon}} selected{{end}}" data-icon="{{.}}" title="{{iconLabel .}}">
									<img src="/admin/icons/{{.}}" alt="{{iconLabel .}}" />
								</button>
								{{end}}
							</div>
						</span>
					</span>
				</span>
				<input type="checkbox" class="eye" title="Enabled" name="enabled[{{.Channel}}]" {{if .Enabled}}checked{{end}} />
			</div>
			{{end}}
		</div>
	</form>
</section>
{{end}}
