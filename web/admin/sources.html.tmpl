{{define "sources-section"}}
<section id="section-sources"{{if .OOB}} hx-swap-oob="true"{{end}}>
	<h2>Sources (channels &amp; groups)</h2>
	<p class="hint">Create personal mixing layouts with channels and group buses here. Layouts can be assigned to auxes in the Auxes tab.</p>

	<div class="layout-picker">
		<select name="layout" hx-get="/admin/sources" hx-target="#section-sources" hx-swap="outerHTML">
			{{range .Layouts}}
			<option value="{{.ID}}" {{if eq .ID $.LayoutID}}selected{{end}}>{{.Name}}</option>
			{{end}}
		</select>
		{{if .IsDefault}}
		<form hx-post="/admin/layouts" hx-target="#section-sources" hx-swap="outerHTML" hx-include="[name='layoutId']" class="inline-form">
			<input type="hidden" name="name" value="New Layout" />
			<button type="submit">+ New layout</button>
		</form>
		{{else}}
		<input type="text" class="layout-name-field" name="name" value="{{.LayoutName}}" hx-post="/admin/layouts/{{.LayoutID}}/rename" hx-target="#section-sources" hx-swap="outerHTML" hx-trigger="change" />
		<button type="button" class="danger" hx-post="/admin/layouts/{{.LayoutID}}/delete" hx-target="#section-sources" hx-swap="outerHTML" hx-confirm="Delete this layout? Any aux using it falls back to Default.">Delete layout</button>
		<form hx-post="/admin/layouts" hx-target="#section-sources" hx-swap="outerHTML" hx-include="[name='layoutId']" class="inline-form">
			<input type="hidden" name="name" value="{{.LayoutName}} copy" />
			<button type="submit">+ New layout</button>
		</form>
		{{end}}
	</div>

	<div class="toolbar">
		<div class="toolbar-group">
			<button
				type="button"
				class="danger"
				hx-post="/admin/sources/reset"
				hx-target="#section-sources"
				hx-swap="outerHTML"
				hx-include="[name='layoutId']"
				hx-confirm="Reset this layout to default (channels then groups, ascending)? This clears every customization."
			>Reset layout</button>
			<button type="button" id="sources-toggle-all">Show/Hide all</button>
		</div>
	</div>

	<form id="sources-form" hx-post="/admin/sources/save" hx-target="#section-sources" hx-swap="outerHTML">
		<input type="hidden" name="layoutId" value="{{.LayoutID}}" />
		<div id="sources-list">
			{{range .Items}}
				{{if .IsSection}}{{template "section-marker" .Section}}{{else}}{{template "source-card" .Source}}{{end}}
			{{end}}
		</div>
	</form>

	<details class="help">
		<summary>Help</summary>
		<ul>
			<li><b>Reorder:</b> drag by the handle (&#8942;&#8942;). Saves immediately.</li>
			<li><b>Multi-select:</b>
				<ul>
					<li>Click sources/sections to select them (keyboard: <b>Shift</b> for a range, <b>Ctrl</b>/<b>Cmd</b> for single).</li>
					<li>Drag or show/hide one of them to apply it to all selected.</li>
					<li>Click an empty spot to deselect.</li>
				</ul>
			</li>
			<li><b>Sections:</b> hover or click a source, then click <b>+ Section</b> to insert one above.</li>
		</ul>
	</details>
</section>
{{end}}

{{define "source-card"}}
<div class="source-card {{.Type}}{{if .Stereo}} stereo{{end}}" data-kind="source" data-type="{{.Type}}" data-number="{{.Number}}">
	<span class="drag-handle" title="Drag to reorder">&#8942;&#8942;</span>
	<span class="badge">{{badge .Type .Number}}</span>
	<span class="label">{{.Label}}</span>
	<button type="button" class="add-section-btn" data-before-key="source:{{.Type}}:{{.Number}}" title="Add section above">+ Section</button>
	<input type="checkbox" class="enabled-field eye" title="Enabled" {{if .Enabled}}checked{{end}} />
</div>
{{end}}

{{define "section-marker"}}
<div class="section-marker" data-kind="section" data-id="{{.ID}}">
	<span class="drag-handle" title="Drag to reorder">&#8942;&#8942;</span>
	<input type="text" class="section-name-field" value="{{.Name}}" />
	<button type="button" hx-post="/admin/sections/{{.ID}}/delete" hx-target="#section-sources" hx-swap="outerHTML">Delete</button>
</div>
{{end}}
