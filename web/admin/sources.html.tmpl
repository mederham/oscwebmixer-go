{{define "sources-section"}}
<section id="section-sources"{{if .OOB}} hx-swap-oob="true"{{end}}>
	<h2>Sources (channels &amp; groups)</h2>
	<p class="hint">Drag anything to reorder — a section can sit anywhere among channels/groups; everything after it belongs to it until the next section or the end. Field edits (enabled/icon/section name) need the Save button below; dragging persists immediately.</p>

	<form id="sources-form" hx-post="/admin/sources/save" hx-target="#section-sources" hx-swap="outerHTML">
		<div id="sources-list">
			{{range .Items}}
				{{if .IsSection}}{{template "section-marker" .Section}}{{else}}{{template "source-card" .Source}}{{end}}
			{{end}}
		</div>
		<button type="submit">Save</button>
	</form>

	<form hx-post="/admin/sections" hx-target="#section-sources" hx-swap="outerHTML" class="inline-form">
		<input type="text" name="name" placeholder="New section name" required />
		<button type="submit">+ Add section</button>
	</form>
</section>
{{end}}

{{define "source-card"}}
<div class="source-card {{.Type}}" data-kind="source" data-type="{{.Type}}" data-number="{{.Number}}">
	<span class="drag-handle" title="Drag to reorder">&#8942;&#8942;</span>
	<span class="badge">{{.Badge}}</span>
	<span class="label">{{.Label}}</span>
	<label class="enabled"><input type="checkbox" class="enabled-field" {{if .Enabled}}checked{{end}} /> Enabled</label>
	<input type="text" class="icon-field" value="{{.Icon}}" placeholder="Icon URL" />
</div>
{{end}}

{{define "section-marker"}}
<div class="section-marker" data-kind="section" data-id="{{.ID}}">
	<span class="drag-handle" title="Drag to reorder">&#8942;&#8942;</span>
	<input type="text" class="section-name-field" value="{{.Name}}" />
	<button type="button" hx-post="/admin/sections/{{.ID}}/delete" hx-target="#section-sources" hx-swap="outerHTML">Delete</button>
</div>
{{end}}
