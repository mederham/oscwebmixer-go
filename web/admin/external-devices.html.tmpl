{{define "external-devices-section"}}
<section id="section-external-devices">
	<h2>External devices</h2>
	<p class="hint">Broadcast doubles as this device's enable/disable — off means it never receives relayed traffic. Edits save as soon as you change a field.</p>
	<div class="cards">
		{{range .ExternalDevices}}
		<div class="device-card" hx-post="/admin/external-devices/{{.ID}}" hx-trigger="change" hx-include="closest .device-card" hx-target="#section-external-devices" hx-swap="outerHTML">
			<input type="checkbox" class="toggle" name="broadcast" title="Broadcast" {{if .Broadcast}}checked{{end}} />
			<div class="device-fields">
				<input type="text" name="name" value="{{.Name}}" placeholder="Name" />
				<div class="device-address">
					<input type="text" name="ip" value="{{.IP}}" placeholder="IP" />
					<input type="number" name="port" value="{{.Port}}" placeholder="Port" />
				</div>
			</div>
			<label class="loopback"><input type="checkbox" name="loopback" {{if .Loopback}}checked{{end}} /> Loopback</label>
			<button type="button" hx-post="/admin/external-devices/{{.ID}}/delete" hx-target="#section-external-devices" hx-swap="outerHTML">Remove</button>
		</div>
		{{end}}
	</div>
	<button type="button" id="add-device-toggle">+ Add device</button>
	<form hx-post="/admin/external-devices" hx-target="#section-external-devices" hx-swap="outerHTML" class="device-card add-device" hidden>
		<input type="checkbox" class="toggle" name="broadcast" title="Broadcast" checked />
		<div class="device-fields">
			<input type="text" name="name" placeholder="Name" required />
			<div class="device-address">
				<input type="text" name="ip" placeholder="IP" required />
				<input type="number" name="port" placeholder="Port" required />
			</div>
		</div>
		<label class="loopback"><input type="checkbox" name="loopback" /> Loopback</label>
		<button type="submit">Add device</button>
	</form>
</section>
{{end}}
